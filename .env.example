# Copy to .env and edit. .env is never committed. Every value here is a placeholder.

# REQUIRED. Password of the bundled PostgreSQL owner role ("lachesis"). It is used only by the one-shot
# migrate container; the server never sees it. Letters and digits only:
#   openssl rand -hex 16
POSTGRES_PASSWORD=

# REQUIRED. Password of the least-privilege role the server runs as ("lachesis_app": read/write on the
# tables, append-only on the audit log, no schema changes). The migrate container creates the role with
# this password on first run (an existing role keeps its password). At least 16 characters, letters and
# digits only:
#   openssl rand -hex 16
LACHESIS_DB_APP_PASSWORD=

# Only when running the binary outside compose (compose builds these from the passwords above).
# DATABASE_URL is the server's connection (the application role). MIGRATE_DATABASE_URL, when set, is
# the schema owner: `lachesis migrate` and the migration step of `serve` use it, and the server then
# connects as DATABASE_URL without the right to change the schema or the audit log. LACHESIS_DB_APP_ROLE
# and LACHESIS_DB_APP_PASSWORD make `migrate` create and grant that role. See docs/install.md.
# DATABASE_URL=postgres://lachesis_app:CHANGE_ME@db.example.com:5432/lachesis?sslmode=require
# MIGRATE_DATABASE_URL=postgres://lachesis:CHANGE_ME@db.example.com:5432/lachesis?sslmode=require
# LACHESIS_DB_APP_ROLE=lachesis_app
# LACHESIS_DB_APP_PASSWORD=

# The address people type into the browser. State-changing requests must carry exactly this
# origin. An https:// address turns on Secure cookies and HSTS, and requires TRUST_PROXY (below):
# Lachesis itself speaks plain HTTP behind a TLS reverse proxy.
LACHESIS_BASE_URL=http://localhost:8080

# Listen address inside the process (default 127.0.0.1:8080). compose sets 0.0.0.0:8080 in the
# container and publishes it on LACHESIS_PUBLISH_ADDR below.
# LACHESIS_BIND=127.0.0.1:8080

# Master key (KEK) that wraps the data keys protecting stored credentials. Preferred: a file
# holding 32 random bytes, base64-encoded, that only the container user (uid 65532) can read:
#   mkdir -p secrets && ( umask 077; openssl rand -base64 32 > secrets/master.key )
#   sudo chown 65532 secrets/master.key && chmod 600 secrets/master.key
# compose bind-mounts ./secrets/master.key (or the file named here) as a docker secret at
# /run/secrets/lachesis_master_key and points LACHESIS_MASTER_KEY_FILE at it. Non-swarm compose
# ignores the uid/mode settings of a secret, so the host file's own owner and mode are what the
# container sees; `docker compose up` fails if the file does not exist. The key is never stored in
# the database; keep a separate backup of it.
# LACHESIS_MASTER_KEY_SECRET_FILE=./secrets/master.key
# Outside compose you can instead set exactly one of these two (the file is preferred):
# LACHESIS_MASTER_KEY_FILE=/run/secrets/lachesis_master_key
# LACHESIS_MASTER_KEY=

# First-run setup token (at least 16 characters): needed to create the first administrator from
# the setup page when single sign-on is not configured. Unused once an administrator exists; with
# no token set, setup is unavailable.
#   openssl rand -hex 16
LACHESIS_SETUP_TOKEN=

# Single sign-in (OIDC). Leave all of these empty for local accounts only; set the first four
# together. The client secret is a file, never a value.
# LACHESIS_OIDC_ISSUER=https://idp.example.com/application/o/lachesis/
# LACHESIS_OIDC_CLIENT_ID=lachesis
# LACHESIS_OIDC_CLIENT_SECRET_FILE=/run/secrets/lachesis_oidc_client_secret
# group=role pairs; roles are admin, operator, viewer
# LACHESIS_OIDC_ROLE_MAP=admins=admin,netops=operator,readers=viewer
# Name of the groups claim in the ID token (default: groups)
# LACHESIS_OIDC_GROUPS_CLAIM=groups
# Redirect URI to register with the provider: LACHESIS_BASE_URL + /auth/oidc/callback
# Scopes: openid profile email groups. The secret file must be chmod 600; a person in no mapped
# group is refused (there is no default role).

# Password sign-in for local accounts: true = administrators only (break-glass). Default: true
# when single sign-on is configured, false otherwise.
# LACHESIS_LOCAL_ADMINS_ONLY=true

# Behind a reverse proxy, name the proxy: an address or a comma-separated list of addresses or
# CIDR prefixes (for example 192.0.2.10 or 198.51.100.0/24); 1 means one proxy on a private
# address. Lachesis then takes each visitor's address from X-Forwarded-For. Required when
# LACHESIS_BASE_URL is https. Without a proxy leave it empty: nothing is trusted.
TRUST_PROXY=

# Rate limits of the plan/apply engine, in events per hour (whole numbers, 1 to 100000).
# Applies are counted per API token and per person (a person's session and all their tokens
# together). Plan creation, and refused applies and approvals, have their own, more generous buckets.
# LACHESIS_APPLY_RATE_TOKEN=30
# LACHESIS_APPLY_RATE_USER=60
# LACHESIS_PLAN_RATE_TOKEN=120
# LACHESIS_PLAN_RATE_USER=240

# MCP server for AI agents (off by default). true serves MCP at /mcp (streamable HTTP) for Bearer API
# tokens that carry the read scope; cookies are not accepted there. Read-only in this version.
# For a local agent that speaks stdio, run `lachesis mcp --stdio --token-file PATH --url https://...`.
LACHESIS_MCP_ENABLED=false
# Calls one API token may make to MCP per minute (whole number, 1 to 6000).
# LACHESIS_MCP_RATE_TOKEN=120

# Requests per minute one client address may make with an Authorization header (API tokens, REST and
# /mcp; whole number, 1 to 100000). Over it: 429 with Retry-After. The address is the one TRUST_PROXY
# resolves, never a raw X-Forwarded-For; an IPv6 client counts by its /64. Raise it for many clients behind
# one NAT. Behind a reverse proxy, TRUST_PROXY must be set: otherwise every client shares the proxy's
# address, and one stream of junk requests can make everybody get 429.
# LACHESIS_BEARER_RATE_IP=600

# Days of audit log to keep. After the migrations, the one-shot migrate container (the database owner)
# deletes older rows and writes an audit.prune marker; `docker compose run --rm audit-prune` does the same
# on demand. 0 keeps everything forever; otherwise 7 or more. The app itself can never delete audit rows.
# LACHESIS_AUDIT_RETENTION_DAYS=365

# Approval webhook (off unless the URL is set): a small signed JSON message when a plan starts waiting for
# approval and when one is rejected. Plan id, intent kind, server names, the author's display name, the
# expiry and a link; no reason text and nothing secret. The URL may carry a token, so it is never logged.
# Deliveries go through the egress guard: a receiver on loopback or another denied range needs its network
# in LACHESIS_EGRESS_ALLOW. The signature is X-Lachesis-Signature: sha256=HMAC-SHA256(secret, timestamp + "." + body),
# with the timestamp in X-Lachesis-Timestamp. The secret is a file (chmod 600, an absolute path), never a value.
# LACHESIS_APPROVAL_WEBHOOK_URL=https://hooks.example.com/lachesis
# LACHESIS_APPROVAL_WEBHOOK_SECRET_FILE=/run/secrets/lachesis_approval_webhook_secret

# Extra networks adapters may reach even though the egress guard denies them by default
# (comma-separated CIDRs; for example a DHCP server reachable only on loopback in a lab).
# LACHESIS_EGRESS_ALLOW=203.0.113.0/24

# Secret references (a credential stored as env://NAME or file:///path instead of a value). Default-deny:
# file references work only under the directories listed here (colon separated, absolute; unset = file
# references are disabled), and env references only for names starting with the prefix below. Lachesis's
# own settings, the master key file and /proc, /sys, /dev can never be referenced.
# LACHESIS_SECRET_REF_DIRS=/run/secrets/refs
# LACHESIS_SECRET_REF_ENV_PREFIX=LACHESIS_REF_

# debug, info, warn or error
LACHESIS_LOG_LEVEL=info

# compose publishes the web port on the loopback interface only (plain HTTP). Set one private
# address to publish there instead.
# LACHESIS_PUBLISH_ADDR=127.0.0.1


# Image tag to run. The default is the version of the files you downloaded (0.2.0). Set a release number to
# upgrade or roll back without replacing compose.yaml, or "latest" to follow the newest release.
# LACHESIS_VERSION=0.2.0
